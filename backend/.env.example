# Copy this file to .env and fill in real values.
# .env is gitignored; this template is committed.
#
# NOTE: .env is loaded only by app/config/settings.py, i.e. by the web app
# (`uvicorn main:app`). The CLI entry points -- app/cli/check_config.py,
# app/cli/dump_ocr.py, extraction_pipeline/pipeline.py and the eval scripts --
# do not import it, so those need real environment variables instead.
# (check_azure_vlm.py below is the one exception -- it loads .env itself.)

# --- App -------------------------------------------------------------------
APP_TITLE=Vendor Form Extractor
DEBUG=false

# --- Paths (optional; default to backend/app/uploads and backend/app/outputs)
# VENDOR_UPLOAD_DIR=
# VENDOR_OUTPUT_DIR=

# --- Logging (optional; DEBUG / INFO / WARNING / ERROR) --------------------
# VENDOR_LOG_LEVEL=INFO

# --- OCR (optional; read by extraction_pipeline/ingest/ocr_engine.py) ------
# Which OCR engine runs. rapidocr is the ACTIVE DEFAULT as of 2026-09-01
# (scored 19/24, 1 wrong, 0 hallucinated against verified ground truth --
# identical to PaddleOCR's score on the same file; see ocr_engine.py's
# comment above _REQUESTED_BACKEND for the evidence and the shared bug).
# paddleocr is the PRESERVED FALLBACK: its execution path is commented out in
# ocr_engine.py, so switching back needs BOTH this variable AND uncommenting
# that code -- see the "PRESERVED FALLBACK" banners in ocr_engine.py's
# _load() for the exact restore steps.
# OCR_BACKEND=rapidocr

# Device PaddleOCR runs on (only relevant once the fallback is restored).
# Falls back to CPU automatically if a GPU is requested but turns out to be
# unusable.
# OCR_ENGINE_DEVICE=cpu
#
# ocr_engine.py sets this to "0" at import time to work around a PaddlePaddle
# 3.3.1 CPU executor crash in the oneDNN run mode. An explicit value here always
# wins, so oneDNN can be re-enabled and re-tested after an upstream fix without
# editing code.
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0

# --- One-off: Azure AI Foundry connectivity test (app/cli/check_azure_vlm.py) ---
# Not read by the running app -- only by that one standalone script, which
# loads this file itself. AZURE_AI_ENDPOINT must be the model's inference URL
# (https://<resource-name>.services.ai.azure.com/models), not the Foundry
# project/portal URL. Both the endpoint and AZURE_AI_MODEL (the deployment
# name) are shown together on the deployment's details page in the portal.
# AZURE_AI_ENDPOINT=
# AZURE_AI_KEY=
# AZURE_AI_MODEL=

# --- One-off: Hoka Azure GPT deployment test (app/cli/check_azure_gpt.py) -------
# Also not read by the running app. Endpoint must include the /openai/v1 suffix,
# e.g. https://hokashoes.openai.azure.com/openai/v1
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_MODEL=

# --- Reserved: not read by any code today ----------------------------------
# The Gemini (V1) pipeline was removed in df90783; master is PaddleOCR-only and
# fully offline. These are placeholders for if/when it is rebuilt -- setting
# them has no effect right now. Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
DEFAULT_PIPELINE=auto
