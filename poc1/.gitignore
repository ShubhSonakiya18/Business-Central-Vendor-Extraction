# Generated at runtime -- SQLite DB, uploaded vendor documents (PII: GSTIN,
# PAN, bank details), and generated Excel exports. Same reasoning as the
# repo root .gitignore's backend/app/uploads/ etc: never commit this.
storage/

# Test fixtures regenerated by tests/fixtures/make_fixtures.py
tests/fixtures/*.pdf

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/

# Env / secrets
.env
