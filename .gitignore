# Runtime data — contains real vendor documents and extracted PII (GSTIN, PAN, bank details)
/uploads/
/outputs/

# Ground truth for real vendors transcribes the same PII as the source documents
# (GSTIN, PAN, bank account numbers). Git history is permanent, so only the
# synthetic example is tracked; real vendor files stay local.
/eval/ground_truth/*.yaml
!/eval/ground_truth/example_synthetic.yaml

