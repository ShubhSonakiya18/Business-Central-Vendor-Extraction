# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is the template committed to the repo.

# --- V1 pipeline (Gemini, cloud) -------------------------------------------
# Required only if you want V1 available. Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Routing -----------------------------------------------------------
# Which pipeline "/" serves by default.
#   auto -> V1 if GEMINI_API_KEY is set, otherwise V2 (local, offline)
#   v1   -> always V1 (fails if google-genai isn't installed or key is missing)
#   v2   -> always V2
DEFAULT_PIPELINE=auto

# --- App -----------------------------------------------------------------
APP_TITLE=Vendor Form Extractor
DEBUG=false

# --- Paths (optional overrides; default to project-root uploads/ and outputs/) --
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs

# --- V2 / PaddlePaddle escape hatch (optional) ---------------------------------
# app/pipelines/v2/ocr_engine.py sets this to "0" at import time to work around a
# PaddlePaddle 3.3.1 CPU executor crash in the oneDNN run mode. An explicit value
# here always wins, so oneDNN can be re-enabled (and re-tested) after an upstream
# fix without editing code. See DECISIONS.md D-11.
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
