# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is the template committed to the repo.

# --- V1 pipeline (Gemini, cloud) -------------------------------------------
# Required only if you want V1 available. Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Routing -----------------------------------------------------------
# Which pipeline "/" serves by default.
#   auto -> V1 if GEMINI_API_KEY is set, otherwise V2 (local, offline)
#   v1   -> always V1 (fails if google-genai isn't installed or key is missing)
#   v2   -> always V2
DEFAULT_PIPELINE=auto

# --- App -----------------------------------------------------------------
APP_TITLE=Vendor Form Extractor
DEBUG=false

# --- Paths (optional overrides; default to project-root uploads/ and outputs/) --
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
